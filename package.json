{
  "name": "cv-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generator CV pod polski rynek pracy: szablony ATS, zdjęcie, klauzula RODO i eksport PDF.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode dev",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:slow": "tsx --test tests/*.slow.ts",
    "test:all": "npm test && npm run test:slow",
    "check:prod": "tsx scripts/check-prod.mjs",
    "check:closed": "tsx scripts/check-prod.mjs closed --android",
    "android:sync": "npm run build && cap sync android && node scripts/install-native.mjs",
    "build:closed": "tsc --noEmit && vite build --mode closed",
    "android:sync:closed": "npm run build:closed && cap sync android && node scripts/install-native.mjs",
    "android:sync:dev": "npm run build:dev && cap sync android && node scripts/install-native.mjs",
    "android:open": "cap open android",
    "android:icons": "npx --yes @capacitor/assets generate --android",
    "android:native": "node scripts/install-native.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/roboto": "^5.0.0",
    "pdfmake": "0.2.7",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsqr": "1.4.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
